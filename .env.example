AZURE_SQL_CONNECTIONSTRING="Server=SERVER_NAME;Database=NAME_DATABASE;UID=USER_NAME;PWD=PASSWORD;Encrypt=yes;TrustServerCertificate=no"
# URL da API de ingestão; também é gravada em Leituras.fonte (máx. 100 caracteres).
FONTE_DADOS="URL_API"
# Chave Fernet para criptografar o e-mail dos operadores (a mesma para todo o time).
# Gerar com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CHAVE_CRIPTOGRAFIA="CHAVE_FERNET"
# Segredo opcional somado ao hash de CPF e nome (HMAC-SHA256). Vazio = SHA-256 puro.
CHAVE_HASH="SEGREDO_HASH"
# Chave exigida no header X-API-Key pelas rotas /api/v1/bi (Power BI). Vazia = rotas abertas (uso local).
CHAVE_API_BI="CHAVE_API_BI"
# Pasta com os Parquet da camada Gold lidos pela API do BI. Padrão: data_lake/gold.
DIRETORIO_GOLD="data_lake/gold"

# --- Agente analítico (docs/agente). Lido só por load_config_agente(). ---
# Fornecedor do LLM: openai, anthropic ou simulado (LLM roteirizado, sem rede e sem chave).
AGENTE_LLM_FORNECEDOR="simulado"
# Modelo das chamadas ao LLM. OpenAI (DA11): gpt-4.1-mini. Anthropic (DA9): claude-haiku-5-5.
# Obrigatório se o fornecedor não for simulado.
AGENTE_LLM_MODELO="NOME_DO_MODELO"
# Chave da API da OpenAI (começa com sk-proj-). Obrigatória com AGENTE_LLM_FORNECEDOR=openai.
OPENAI_API_KEY="CHAVE_OPENAI"
# Chave da API da Anthropic (começa com sk-ant-). Obrigatória com AGENTE_LLM_FORNECEDOR=anthropic.
ANTHROPIC_API_KEY="CHAVE_ANTHROPIC"
# Conexão SÓ DE LEITURA do agente (usuário agente_leitura, sql/seguranca/agente_usuario_leitura.sql).
# Obrigatória com AGENTE_LLM_FORNECEDOR=openai ou anthropic. Nunca use a connection string da ingestão.
AGENTE_SQL_CONNECTIONSTRING="Server=SERVER_NAME;Database=NAME_DATABASE;UID=agente_leitura;PWD=PASSWORD;Encrypt=yes;TrustServerCertificate=no"
# Opcionais. Vazios = valor padrão.
# Modelo de embeddings do fastembed. Padrão: sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2.
AGENTE_EMBEDDINGS_MODELO=""
# Banco vetorial: memoria (padrão) ou chroma (data/agente/chroma). Rode --indexar ao trocar.
AGENTE_VETORES=""
# Pasta do índice local, fora do Git. Padrão: data/agente.
AGENTE_DIR_INDICE=""
# Limites (DA6). Padrões: 6 chamadas de ferramenta, 50 linhas, 10 turnos, 60 s.
AGENTE_MAX_FERRAMENTAS=""
AGENTE_MAX_LINHAS=""
AGENTE_HISTORICO_TURNOS=""
AGENTE_TIMEOUT_SEGUNDOS=""
# Página /agente do dashboard (POL-07 e POL-10). Limite padrão: 10 per minute;200 per day.
# Preencha AGENTE_CHAVE_WEB se o servidor sair do 127.0.0.1: passa a exigir o header X-API-Key.
AGENTE_LIMITE_WEB=""
AGENTE_CHAVE_WEB=""
# Consumo por pergunta (POL-07). Padrões: 16000 tokens de saída (o raciocínio do modelo conta aqui),
# esforço medium (low, medium ou high), 60000 tokens de entrada acumulados e 180 s no total.
AGENTE_MAX_TOKENS_SAIDA=""
AGENTE_ESFORCO=""
AGENTE_MAX_TOKENS_PERGUNTA=""
AGENTE_PRAZO_PERGUNTA_SEGUNDOS=""
