AZURE_SQL_CONNECTIONSTRING="Server=SERVER_NAME;Database=NAME_DATABASE;UID=USER_NAME;PWD=PASSWORD;Encrypt=yes;TrustServerCertificate=no"
# URL da API de ingestão; também é gravada em Leituras.fonte (máx. 100 caracteres).
FONTE_DADOS="URL_API"
# Chave Fernet para criptografar o e-mail dos operadores (a mesma para todo o time).
# Gerar com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CHAVE_CRIPTOGRAFIA="CHAVE_FERNET"
# Segredo opcional somado ao hash de CPF e nome (HMAC-SHA256). Vazio = SHA-256 puro.
CHAVE_HASH="SEGREDO_HASH"
